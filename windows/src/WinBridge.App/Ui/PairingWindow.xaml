<Window x:Class="WinBridge.App.Ui.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair a phone" Height="560" Width="420"
        Background="{StaticResource Bg}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22">
        <TextBlock x:Name="LblScan" Style="{StaticResource Heading}" Text="Scan this code" />

        <Border Background="White" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="260" Height="260" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <TextBlock x:Name="LblPin" Style="{StaticResource Dim}" Margin="0,16,0,4" HorizontalAlignment="Center" />
        <TextBlock x:Name="LblPinValue" FontSize="26" FontFamily="Consolas"
                   HorizontalAlignment="Center" Foreground="{StaticResource Fg}" />

        <TextBlock x:Name="LblExpires" Style="{StaticResource Dim}" Margin="0,16,0,0"
                   HorizontalAlignment="Center" />

        <TextBlock x:Name="LblResult" Margin="0,12,0,0" HorizontalAlignment="Center"
                   Foreground="{StaticResource Good}" FontFamily="Segoe UI Semibold" />

        <TextBlock x:Name="LblBluetoothNote" Style="{StaticResource Dim}" Margin="0,18,0,0" />

        <Button x:Name="BtnClose" Content="Close" HorizontalAlignment="Center"
                Margin="0,18,0,0" Style="{StaticResource Subtle}" Click="OnCloseClick" />
    </StackPanel>
</Window>
