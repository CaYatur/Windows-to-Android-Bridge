<Window x:Class="WinBridge.App.Ui.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinBridge" Height="480" Width="620"
        MinHeight="360" MinWidth="520"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="True">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblTitle" Grid.Row="0" Style="{StaticResource Heading}" TextWrapping="Wrap" />

        <Border Grid.Row="1" x:Name="RiskBorder" CornerRadius="6" Padding="10" Margin="0,4,0,12">
            <TextBlock x:Name="LblRisk" TextWrapping="Wrap" Foreground="White" />
        </Border>

        <Border Grid.Row="2" Background="#FF17171B" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="LblSteps" FontFamily="Consolas" FontSize="12.5"
                           Foreground="#FFE8E8EE" TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnRefuse" Content="Refuse" Width="120" Margin="0,0,10,0" Click="OnRefuse" IsCancel="True" />
            <Button x:Name="BtnAllow" Content="Allow" Width="140" Click="OnAllow" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
