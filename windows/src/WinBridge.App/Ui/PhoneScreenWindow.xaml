<Window x:Class="WinBridge.App.Ui.PhoneScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone screen" Height="760" Width="420"
        MinHeight="420" MinWidth="280"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnBack" Content="Back" Width="72" Margin="3,0" Click="OnNav" Tag="back" />
                <Button x:Name="BtnHome" Content="Home" Width="72" Margin="3,0" Click="OnNav" Tag="home" />
                <Button x:Name="BtnRecents" Content="Recents" Width="80" Margin="3,0" Click="OnNav" Tag="recents" />
                <Button x:Name="BtnNotifications" Content="Shade" Width="72" Margin="3,0" Click="OnNav" Tag="notifications" />
                <Button x:Name="BtnLock" Content="Lock" Width="64" Margin="3,0" Click="OnNav" Tag="lock" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource Card}" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="LblStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="0,0,12,0" Text="Connecting…" />
                <CheckBox x:Name="ChkInteract" Content="Touch control" IsChecked="True" VerticalAlignment="Center"
                          Margin="0,0,12,0" />
                <CheckBox x:Name="ChkAudio" Content="Phone audio" VerticalAlignment="Center"
                          Checked="OnAudioToggled" Unchecked="OnAudioToggled" />
            </StackPanel>
        </Border>

        <Grid Background="#FF08080A" ClipToBounds="True">
            <Image x:Name="Surface" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"
                   MouseDown="OnSurfaceDown" MouseMove="OnSurfaceMove" MouseUp="OnSurfaceUp"
                   MouseWheel="OnSurfaceWheel" Focusable="True" />
            <TextBlock x:Name="LblOverlay" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
        </Grid>
    </DockPanel>
</Window>
