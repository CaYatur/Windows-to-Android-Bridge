    <!-- Setup -->
    <string name="setup_welcome_title">Connect your PC</string>
    <string name="setup_welcome_body">Install WinBridge on Windows, then choose “Pair a phone” from its tray icon and scan the code it shows.</string>
    <string name="setup_scan">Scan the code</string>
    <string name="setup_permissions_title">Permissions</string>
    <string name="setup_permissions_body">Bluetooth is needed to reach your PC without Wi-Fi. Camera is needed only to scan the pairing code.</string>
    <string name="setup_grant">Grant</string>
